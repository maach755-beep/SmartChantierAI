# Production — copy to .env.production or inject via CI/CD / docker-compose

# Frontend (build-time for Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_API_URL=https://api.your-domain.com
VITE_TAVILY_API_KEY=
VITE_OLLAMA_BASE_URL=
VITE_OLLAMA_TEXT_MODEL=llama3.1

# API server
PORT=3001
CORS_ORIGIN=https://app.your-domain.com
NODE_ENV=production
DATA_DIR=server/data
UPLOAD_DIR=server/uploads
OCR_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
TAVILY_API_KEY=
OPENAI_API_KEY=
