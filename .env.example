# Frontend (Vite)
VITE_API_URL=http://localhost:3001
VITE_TENANT_ID=tenant_default

# Recherche web réelle (Tavily) — Assistant Achat IA & Recherche Globale
VITE_TAVILY_API_KEY=
VITE_TAVILY_MAX_RESULTS=10
VITE_TAVILY_SEARCH_DEPTH=advanced
# Clé serveur (prod / proxy API) — optionnel si VITE_TAVILY_API_KEY déjà défini
TAVILY_API_KEY=

# IA locale Ollama (défaut — OpenAI optionnel uniquement)
VITE_OLLAMA_BASE_URL=
# Dev: laisser vide pour proxy Vite /ollama → localhost:11434
VITE_OLLAMA_TEXT_MODEL=llama3.1
VITE_OLLAMA_VISION_MODEL=llava
VITE_OLLAMA_TIMEOUT_MS=90000

# OpenAI — optionnel (non requis si Ollama actif)
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# Supabase — auth + database (production)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Run supabase/migrations/001_core_schema.sql in SQL editor after creating project
VITE_SUPABASE_CATALOG_TABLE=procurement_catalog
VITE_SUPPLIER_API_URL=

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATA_DIR=server/data
UPLOAD_DIR=server/uploads
DEFAULT_TENANT_ID=tenant_default

# AI providers (production) — ollama par défaut sur le serveur API
OCR_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
VISION_API_URL=
VISION_API_KEY=
COLOR_API_URL=
OPENAI_API_KEY=
