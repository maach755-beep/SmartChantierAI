{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "server/dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"]
}
